{
  "name": "classmate-reminder",
  "version": "0.1.3",
  "private": true,
  "description": "课序 · Windows / 安卓课表与提醒",
  "author": "Classmate contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/domain.test.ts tests/sync-database.test.ts",
    "test:ui": "playwright test",
    "check": "tsc -b && npm run test && node --test tests/desktop-scheduler.test.cjs tests/log-sync.test.cjs",
    "desktop:dev": "node scripts/ensure-electron.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:pack": "node scripts/ensure-electron.mjs && npm run build && electron-builder --win --dir",
    "desktop:dist": "node scripts/ensure-electron.mjs && npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "cn.kexu.schedule",
    "productName": "课序",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "electron/reminders.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "课序"
    }
  }
}
