<?xml version="1.0" encoding="utf-8"?>
<!--
  图标前景：一个电池轮廓，里面一条心电脉冲。

  含义直接对应课题 02 —— 「功耗（电池）」+「热力/负载波动（脉冲）」。
  刻意只用两笔几何：电池外框 + 一条折线，48px 下仍然认得出，
  不会像塞了仪表盘、温度计、闪电的复合图标那样在小尺寸糊成一团。

  构图约束：全部落在直径 66dp 的安全圆内（中心 54,54，半径 ~31），
  这样圆形、方形、squircle 各家的遮罩都不会切到笔画。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 电池外壳 -->
    <path
        android:pathData="M30,42h44a6,6 0 0,1 6,6v12a6,6 0 0,1 -6,6h-44a6,6 0 0,1 -6,-6v-12a6,6 0 0,1 6,-6z"
        android:strokeColor="#EDF2FA"
        android:strokeWidth="4"
        android:strokeLineJoin="round" />

    <!-- 电池正极触点 -->
    <path
        android:pathData="M80,50h2a3,3 0 0,1 3,3v2a3,3 0 0,1 -3,3h-2z"
        android:fillColor="#EDF2FA" />

    <!-- 心电脉冲 -->
    <path
        android:pathData="M31,56h11l5,-6l7,12l5,-6h12"
        android:strokeColor="#6FA8FF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
